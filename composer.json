{
    "name": "coding1688/files",
    "description": "Reusable file upload, reference tracking, multi-disk storage and replication for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required for S3 and Cloudflare R2 disks.",
        "aws/aws-sdk-php": "Required for S3 and Cloudflare R2 disks."
    },
    "autoload": {
        "psr-4": {
            "Coding1688\\Files\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coding1688\\Files\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coding1688\\Files\\FilesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "laravel",
        "file-upload",
        "file-references",
        "storage",
        "s3",
        "r2"
    ],
    "authors": [
        {
            "name": "coding1688"
        }
    ],
    "homepage": "https://github.com/coding1688/files",
    "support": {
        "issues": "https://github.com/coding1688/files/issues"
    }
}
